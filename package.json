{
  "name": "studyhall",
  "productName": "Studyhall",
  "version": "0.18.0",
  "description": "Local-first study and work planner",
  "author": "Studyhall",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "vmp:dev": ".venvScriptspython.exe -m castlabs_evs.vmp sign-pkg node_moduleselectrondist",
    "release": "node scripts/release.cjs",
